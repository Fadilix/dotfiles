/**
 * Stellar Dark - Wallpaper Selector (Perfectly Balanced)
 **/

@import "themes/stellar-colors.rasi"
@import "themes/stellar-dark.rasi"

window {
    width:                       1000px;
    height:                      650px;
    border:                      1px solid;
    border-color:                @accent;
    background-color:            @bg;
}

mainbox {
    spacing:                     15px;
    padding:                     30px;
    children:                    [ "inputbar", "listview" ];
    background-color:            transparent;
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px 0px 15px 0px;
    padding:                     15px 20px;
    border-radius:               10px;
    background-color:            @bg-alt;
    text-color:                  @fg;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    str:                         " ";
    font:                        "JetBrainsMono Nerd Font Bold 16";
    background-color:            transparent;
    text-color:                  @accent;
}

entry {
    font:                        "JetBrainsMono Nerd Font SemiBold 12";
    placeholder:                 "Search Wallpapers...";
}

listview {
    enabled:                     true;
    columns:                     3;
    lines:                       2;
    spacing:                     20px;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
}

element {
    enabled:                     true;
    orientation:                 vertical;
    padding:                     15px;
    spacing:                     10px;
    border-radius:               12px;
    background-color:            transparent;
    text-color:                  @fg;
}

element-icon {
    size:                        250px; 
    horizontal-align:            0.5;
    vertical-align:              0.5;
    border-radius:               10px;
}

element-text {
    font:                        "JetBrainsMono Nerd Font Bold 11";
    horizontal-align:            0.5;
    vertical-align:              0.5;
    text-color:                  inherit;
}

element selected.normal {
    background-color:            @accent;
    text-color:                  #000000;
}
